# Tatum Sui gRPC (host:port, e.g. from Tatum dashboard) and API key
TATUM_API_KEY=
TATUM_GRPC_HOST=
# Fullnode fallback for simulation only
SUI_FALLBACK_GRPC_HOST=fullnode.mainnet.sui.io:443
SUI_NETWORK=mainnet
# Walrus Memory (leave empty to use the in-memory mock)
MEMWAL_PRIVATE_KEY=
MEMWAL_ACCOUNT_ID=
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz
